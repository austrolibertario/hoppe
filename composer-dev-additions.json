{
    "require-dev-additions": {
        "larastan/larastan": "^2.9",
        "laravel/pint": "^1.14",
        "nunomaduro/larastan": "^2.0",
        "phpstan/phpstan": "^1.10",
        "psalm/plugin-laravel": "^2.8",
        "vimeo/psalm": "^5.22"
    },
    "scripts-additions": {
        "lint": "pint",
        "lint:test": "pint --test",
        "analyse": "phpstan analyse --memory-limit=2G",
        "psalm": "psalm --no-cache",
        "test": "php artisan test",
        "test:coverage": "php artisan test --coverage",
        "ci": [
            "@lint:test",
            "@analyse",
            "@test"
        ]
    },
    "note": "Add these to your composer.json require-dev section and scripts section"
}
